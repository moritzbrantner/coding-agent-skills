{
  "schemaVersion": 1,
  "profile": "coding-agent-skills",
  "tiers": {
    "default": [
      "lint",
      "package:check"
    ]
  },
  "requiredCapabilities": [
    "lint",
    "package:check"
  ],
  "capabilityCommands": {
    ".": {
      "package:check": [
        "scripts/validate-capabilities"
      ],
      "lint": [
        "shellcheck",
        "scripts/validate-capabilities"
      ]
    }
  },
  "conventionRefs": [
    "PRINCIPLE-001",
    "PRINCIPLE-003",
    "REPO-001",
    "REPO-012",
    "REPO-013",
    "REP-002",
    "GIT-002"
  ],
  "merge": {
    "authority": "hosted",
    "requiredChecks": [
      "capability-catalog"
    ]
  }
}
